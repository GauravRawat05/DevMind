# ==========================================
# DevMind Environment Variables Template
# Copy this file to '.env' and fill in values
# ==========================================

# 1. Databases (Cloud hosted / Local)
# PostgreSQL connection URL (e.g., Neon or local pg)
DATABASE_URL=postgresql://user:pass@localhost:5432/devmind

# MongoDB connection string (e.g., MongoDB Atlas or local mongo)
MONGODB_URL=mongodb://localhost:27017/devmind

# Redis connection string (e.g., Upstash or local redis)
REDIS_URL=redis://localhost:6379/0

# ChromaDB local storage directory
CHROMADB_PATH=./chroma_db

# 2. AI & LLM Inference Providers
# Groq API key (Llama-3 model processing)
GROQ_API_KEY=your_groq_api_key

# Hugging Face token (for CodeBERT embeddings if using HF API, or general access)
HUGGINGFACE_API_KEY=your_hf_token

# 3. Third-Party API Integrations
# GitHub Personal Access Token (for fetching public repositories)
GITHUB_TOKEN=your_github_pat

# 4. Storage & Infrastructure (AWS or local filesystem mock)
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=devmind-storage
AWS_EC2_REGION=ap-south-1

# 5. Security & Authentication
# JWT secret key for signature validation
JWT_SECRET=your_jwt_secret_change_me
